<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="AI Coding Java P3C - Modern PMD 7"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">

    <description>
        Modern Java static-analysis baseline inspired by Alibaba P3C engineering intent.

        This ruleset intentionally does NOT depend on com.alibaba.p3c:p3c-pmd or any PMD 6
        implementation. It is designed to run on PMD 7.26.0+ and therefore uses PMD 7's
        current Java parser, AST, symbol table, and type-resolution implementation.

        P3C remains the semantic guideline source. Deterministic checks are implemented
        using maintained PMD 7 rules rather than legacy Alibaba PMD rule classes.
    </description>

    <!--
      PMD's maintained Java quickstart ruleset is the deterministic core. It includes
      high-value checks such as naming conventions, braces, missing @Override,
      equals/hashCode correctness, null checks, resource handling, exception stack-trace
      preservation, collection type errors, thread-safety issues, and modern Java cleanup.
    -->
    <rule ref="rulesets/java/quickstart.xml"/>

    <!-- Additional P3C-aligned / production-safety rules not guaranteed by quickstart. -->
    <rule ref="category/java/bestpractices.xml/ArrayIsStoredDirectly"/>
    <rule ref="category/java/bestpractices.xml/AvoidPrintStackTrace"/>
    <rule ref="category/java/bestpractices.xml/MethodReturnsInternalArray"/>

    <!-- Modern JDK / platform safety. -->
    <rule ref="category/java/errorprone.xml/UnsupportedJdkApiUsage"/>
    <rule ref="category/java/multithreading.xml/OverridingThreadRun"/>

    <!-- Security checks aligned with the repository security baseline. -->
    <rule ref="category/java/security.xml/HardCodedCryptoKey"/>
    <rule ref="category/java/security.xml/InsecureCryptoIv"/>

</ruleset>
