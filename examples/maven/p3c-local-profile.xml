<!--
Copy this <profile> into your project's <profiles> section.

Run locally with:
  mvn -Pp3c-local -DskipTests verify

Or, after copying scripts/verify-java.sh into the project:
  bash scripts/verify-java.sh p3c

P3C-PMD 2.1.1 is based on an older PMD/JDK toolchain. Validate it against the
Java syntax used by your project before treating this profile as mandatory.
-->
<profile>
    <id>p3c-local</id>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <sourceEncoding>${project.build.sourceEncoding}</sourceEncoding>
                    <printFailingErrors>true</printFailingErrors>
                    <failOnViolation>true</failOnViolation>
                    <rulesets>
                        <ruleset>${maven.multiModuleProjectDirectory}/config/pmd/p3c.xml</ruleset>
                    </rulesets>
                </configuration>
                <executions>
                    <execution>
                        <id>p3c-local-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>com.alibaba.p3c</groupId>
                        <artifactId>p3c-pmd</artifactId>
                        <version>2.1.1</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</profile>
