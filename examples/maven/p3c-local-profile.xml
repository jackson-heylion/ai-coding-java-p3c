<!--
Copy this <profile> into the project's <profiles> section.

P3C provides rule intent; PMD 7 provides the maintained Java 17/21 parser.
No Alibaba p3c-pmd / PMD 6 runtime is used.

Fast static-only run:
  mvn -Pp3c-local -DskipTests pmd:check

Existing-project audit without build failure:
  mvn -Pp3c-local -DskipTests -Dpmd.failOnViolation=false pmd:check

Single-pass full local validation:
  mvn -Pp3c-local verify
-->
<profile>
    <id>p3c-local</id>

    <properties>
        <pmd.version>7.26.0</pmd.version>
        <pmd.failOnViolation>true</pmd.failOnViolation>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version>

                <configuration>
                    <inputEncoding>${project.build.sourceEncoding}</inputEncoding>
                    <rulesets>
                        <ruleset>${maven.multiModuleProjectDirectory}/config/pmd/p3c.xml</ruleset>
                    </rulesets>
                    <excludeFromFailureFile>${maven.multiModuleProjectDirectory}/config/pmd/exclude-pmd.properties</excludeFromFailureFile>

                    <!-- Local-speed defaults -->
                    <analysisCache>true</analysisCache>
                    <analysisCacheLocation>${project.build.directory}/pmd/pmd.cache</analysisCacheLocation>
                    <includeTests>false</includeTests>
                    <linkXRef>false</linkXRef>
                    <verbose>false</verbose>

                    <!-- Correctness; CLI may override pmd.failOnViolation for audit mode. -->
                    <typeResolution>true</typeResolution>
                    <failOnViolation>${pmd.failOnViolation}</failOnViolation>
                    <failurePriority>5</failurePriority>
                    <printFailingErrors>true</printFailingErrors>
                    <skipPmdError>false</skipPmdError>
                </configuration>

                <executions>
                    <execution>
                        <id>p3c-local-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>

                <!-- Keep PMD runtime modules aligned when overriding the plugin default. -->
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-javascript</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-jsp</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</profile>
